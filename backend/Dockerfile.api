# Stage 1: Runtime Base
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS base
WORKDIR /app
EXPOSE 5001
ENV ASPNETCORE_URLS=http://+:5001

# Stage 2: SDK Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project files for caching restore layer
COPY ["Lms.Core/Lms.Core.csproj", "Lms.Core/"]
COPY ["Lms.Infrastructure/Lms.Infrastructure.csproj", "Lms.Infrastructure/"]
COPY ["Lms.Api/Lms.Api.csproj", "Lms.Api/"]
RUN dotnet restore "Lms.Api/Lms.Api.csproj"

# Copy remaining code and build
COPY Lms.Core/ Lms.Core/
COPY Lms.Infrastructure/ Lms.Infrastructure/
COPY Lms.Api/ Lms.Api/
WORKDIR "/src/Lms.Api"
RUN dotnet publish "Lms.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Stage 3: Final Production Image
FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
RUN mkdir -p wwwroot/uploads/slips wwwroot/uploads/materials wwwroot/uploads/submissions
ENTRYPOINT ["dotnet", "Lms.Api.dll"]
