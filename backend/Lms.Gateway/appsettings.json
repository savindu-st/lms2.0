{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "AccountingLmsSuperSecretKey2026!WithHighEntropyForSecurityAndCompliance",
    "Issuer": "AccountingLms",
    "Audience": "AccountingLmsApp"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "backend-api",
        "Order": 1,
        "RateLimiterPolicy": "auth-policy",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "public-courses-route": {
        "ClusterId": "backend-api",
        "Order": 2,
        "RateLimiterPolicy": "general-policy",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/courses/{**catch-all}"
        }
      },
      "uploads-route": {
        "ClusterId": "backend-api",
        "Order": 3,
        "RateLimiterPolicy": "general-policy",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      },
      "swagger-route": {
        "ClusterId": "backend-api",
        "Order": 4,
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      },
      "protected-api-route": {
        "ClusterId": "backend-api",
        "Order": 10,
        "RateLimiterPolicy": "general-policy",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend-api": {
        "HttpRequest": {
          "Timeout": "00:01:00"
        },
        "Destinations": {
          "api-instance": {
            "Address": "http://localhost:5001"
          }
        }
      }
    }
  }
}
